{
    "name": "backendtsprod",
    "version": "1.0.0",
    "description": "Production grade typescript backend microservice",
    "license": "ISC",
    "author": "Deepak Rajveer Singh",
    "type": "commonjs",
    "main": "dist/server.js",
    "scripts": {
        "dist": "npx tsc",
        "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
        "start": "cross-env NODE_ENV=production node dist/server.js",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "eslint . --ext .js,.ts --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts}": [
            "npm run lint:fix",
            "npm run format:fix"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.1",
        "@types/source-map-support": "^0.5.10",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "3.8.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4"
    },
    "dependencies": {
        "cross-env": "^10.1.0",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "source-map-support": "^0.5.21",
        "winston": "^3.19.0"
    }
}
